# 一画 · 环境变量示例
# Cloudflare：可在 wrangler.jsonc 的 vars 或控制台 Settings → Variables 中设置
# Vercel / EdgeOne：在项目设置的 Environment Variables 中添加
#
# 必改（否则使用默认值，存在被猜解风险）：

# 访客使用密码（访客首次创作时需输入；不设置则使用管理后台中保存的密码，再否则为默认 yihua2026）
ACCESS_PASSWORD=yihua2026

# 管理后台密码（/admin 登录；不设置则使用管理后台中保存的密码，再否则为默认 yihua-admin-2026）
ADMIN_PASSWORD=yihua-admin-2026

# 可选：Upstash Redis（免费）—— Vercel 部署强烈建议配置，用于持久化限额与通道配置
# 注册 https://upstash.com → Create Database（选免费 Regional）→ REST API 页面复制以下两项
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 仅本地开发用：设为 1 时本地服务调用真实上游（默认走模拟，不消耗额度）
YIHUA_USE_REAL_UPSTREAM=
